# Supabase: URL do projeto e chave publicável (pública por design; a proteção é a RLS).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile (captcha do login, cadastro e Esqueci minha senha). Vazio = sem captcha.
# A chave secreta NÃO vai aqui: fica no Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Endereço público do site (QR code e links).
NEXT_PUBLIC_SITE_URL=https://odontra.vercel.app
# E-mail transacional (boas-vindas). Só no servidor: nunca use NEXT_PUBLIC_ aqui.
RESEND_API_KEY=
EMAIL_FROM="Odontra <ola@seu-dominio.com.br>"
